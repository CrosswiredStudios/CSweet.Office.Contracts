<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CSweet.Office.Contracts</PackageId>
    <Version>0.3.0</Version>
    <PackageVersion Condition="'$(CSweetOfficeContractsPackageVersion)' != ''">$(CSweetOfficeContractsPackageVersion)</PackageVersion>
    <Authors>C-Sweet</Authors>
    <Company>C-Sweet</Company>
    <Description>Wire contracts shared by C-Sweet Headquarters and C-Sweet Office.</Description>
    <PackageTags>csweet;office;contracts;grpc;agents</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/CrosswiredStudios/CSweet.Office.Contracts</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Core.Api" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.102" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="ControlPlane\office_control.proto" GrpcServices="Both" />
    <Protobuf Include="Guest\guest_broker.proto" GrpcServices="None" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
